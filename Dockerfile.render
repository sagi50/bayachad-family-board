FROM node:22-alpine AS frontend
WORKDIR /src
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home api
COPY backend ./backend
COPY --from=frontend /src/dist-web ./dist-web
RUN chown -R api:api /app
USER api
EXPOSE 10000
CMD ["sh", "-c", "cd backend && alembic upgrade head && python -m app.manage bootstrap && exec uvicorn app.main:app --app-dir /app/backend --host 0.0.0.0 --port ${PORT:-10000} --no-access-log"]

